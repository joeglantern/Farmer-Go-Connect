NODE_ENV=development
LOG_LEVEL=debug

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
MOBILE_SCHEME=farmgo://

# Data stores (see infra/docker-compose.yml)
DATABASE_URL=postgresql://farmgo:farmgo@localhost:5440/farmgo
REDIS_URL=redis://localhost:6390

# Better Auth
BETTER_AUTH_SECRET=dev-secret-change-me-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000

# Object storage (MinIO / any S3)
S3_ENDPOINT=http://localhost:9010
S3_PUBLIC_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_ACCESS_KEY=farmgo
S3_SECRET_KEY=farmgo-secret
S3_BUCKET_PREFIX=farmgo-

# SMS / USSD: console | africastalking
SMS_PROVIDER=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_USSD_CODE=*384*123#
# Shared secret: register the USSD callback as <API_URL>/webhooks/ussd?token=<AT_USSD_TOKEN>
AT_USSD_TOKEN=dev-ussd-token
# Register SMS delivery reports as <API_URL>/webhooks/sms/delivery-report?token=<AT_DLR_TOKEN>
AT_DLR_TOKEN=dev-dlr-token
AT_ALLOWED_IPS=

# Email (Mailpit locally)
SMTP_HOST=127.0.0.1
SMTP_PORT=1030
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=FarmGo Connect <no-reply@farmgo.co.ke>

# Push: console | expo
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=

# M-Pesa: mock | daraja
MPESA_PROVIDER=mock
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_B2C_SHORTCODE=600000
MPESA_B2C_INITIATOR=testapi
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_CALLBACK_BASE_URL=http://localhost:4000
MPESA_CALLBACK_TOKEN=dev-callback-token
MPESA_ALLOWED_IPS=

# Card payments (hosted checkout): mock | pesapal | disabled
# Register the IPN with Pesapal (RegisterIPN, POST) as <API_URL>/webhooks/pesapal and put its id here.
CARD_PROVIDER=mock
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=

# Business rules
PLATFORM_COMMISSION_BPS=800
DEFAULT_DELIVERY_FEE_CENTS=30000
MATCH_RADIUS_KM=80

# Observability (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Protects /metrics (Prometheus scrape: Authorization: Bearer <token>)
METRICS_TOKEN=

# Development only: your own admin account, created or reset by `pnpm db:seed` (never in production)
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_ADMIN_NAME=
# admin (View as any role) or user (a fresh account that goes through sign-up setup)
DEV_ADMIN_ROLE=

# Database pool and server limits (defaults shown)
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
HTTP_REQUEST_TIMEOUT_MS=30000
SESSION_CACHE_SECONDS=30
SHUTDOWN_DRAIN_MS=5000
# Production only: serve /docs publicly, and the tester-stack switch for mock payments
DOCS_PUBLIC=false
TESTER_STACK=false
ALLOW_MOCK_PROVIDERS=false
