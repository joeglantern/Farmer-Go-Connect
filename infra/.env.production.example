# Production environment. Copy to infra/.env.production on the server and fill in every blank.
# Never commit the real file. Generate each secret on the server, for example:
#   openssl rand -hex 32        (tokens and passwords)
#   openssl rand -base64 48     (BETTER_AUTH_SECRET)
# The API refuses to start in production when a required secret is missing or still a dev value.

NODE_ENV=production
LOG_LEVEL=info
TRUST_PROXY=true

# ── Hostnames ────────────────────────────────────────────────────────────────
# Without a domain, use sslip.io names for the VPS address (Caddy still gets real certificates):
#   API_DOMAIN=api.203.0.113.10.sslip.io  APP_DOMAIN=app.203.0.113.10.sslip.io  FILES_DOMAIN=files.203.0.113.10.sslip.io
API_DOMAIN=
APP_DOMAIN=
FILES_DOMAIN=
ACME_EMAIL=
API_URL=https://${API_DOMAIN}
BETTER_AUTH_URL=https://${API_DOMAIN}
WEB_URL=https://${APP_DOMAIN}
ADMIN_URL=https://${APP_DOMAIN}
CORS_ORIGINS=https://${APP_DOMAIN}
MOBILE_SCHEME=farmgo://

# ── Data services ────────────────────────────────────────────────────────────
POSTGRES_USER=farmgo
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=farmgo
DATABASE_URL=postgresql://farmgo:${POSTGRES_PASSWORD}@postgres:5432/farmgo

# openssl rand -hex 24
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# openssl rand -base64 48
BETTER_AUTH_SECRET=

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://${FILES_DOMAIN}
S3_REGION=us-east-1
# S3_ACCESS_KEY: any name of 3+ characters. S3_SECRET_KEY: openssl rand -hex 24
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PREFIX=farmgo-

# ── Capacity (see docs/SCALING.md; size to the VPS with nproc and free -g) ───
# Keep AUTOSCALE_MAX x DB_POOL_MAX + DB_POOL_MAX (worker) + 10 under PG_MAX_CONNECTIONS.
API_REPLICAS=2
AUTOSCALE_MIN=2
AUTOSCALE_MAX=4
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
API_MEMORY_LIMIT=768m
API_CPU_LIMIT=1.0
WORKER_MEMORY_LIMIT=768m
SESSION_CACHE_SECONDS=30
HTTP_REQUEST_TIMEOUT_MS=30000

# ── SMS and USSD (Africa's Talking) ──────────────────────────────────────────
SMS_PROVIDER=africastalking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=FARMGO
AT_USSD_CODE=*384*123#
# Register the USSD callback as https://<API_DOMAIN>/webhooks/ussd?token=<AT_USSD_TOKEN>
# openssl rand -hex 24
AT_USSD_TOKEN=
# Register the SMS delivery report URL as https://<API_DOMAIN>/webhooks/sms/delivery-report?token=<AT_DLR_TOKEN>
# openssl rand -hex 24
AT_DLR_TOKEN=
# Africa's Talking callback IPs (comma separated); leave empty to rely on the tokens only.
AT_ALLOWED_IPS=

# ── Email and push ───────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=FarmGo Connect <no-reply@farmgo.co.ke>
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=

# ── M-Pesa (Daraja) ──────────────────────────────────────────────────────────
MPESA_PROVIDER=daraja
MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_CALLBACK_BASE_URL=https://${API_DOMAIN}
# At least 16 characters: openssl rand -hex 24
MPESA_CALLBACK_TOKEN=
# Safaricom's published callback IPs (comma separated); leave empty to rely on the token only.
MPESA_ALLOWED_IPS=

# ── Cards (Pesapal hosted checkout): pesapal | disabled ──────────────────────
# Register the IPN with Pesapal (RegisterIPN, POST) as https://<API_DOMAIN>/webhooks/pesapal and put its id here.
CARD_PROVIDER=disabled
PESAPAL_ENV=live
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=

# ── Tester stack only ────────────────────────────────────────────────────────
# A stack for testers where no real money moves may run mock M-Pesa and cards under production
# settings. Both flags are needed, and the API and worker log a warning every 15 minutes.
# Leave both false on the live service.
TESTER_STACK=false
ALLOW_MOCK_PROVIDERS=false
# With both set to true, also set MPESA_PROVIDER=mock and CARD_PROVIDER=mock above.

# ── Business rules ───────────────────────────────────────────────────────────
PLATFORM_COMMISSION_BPS=800
DEFAULT_DELIVERY_FEE_CENTS=30000
MATCH_RADIUS_KM=80

# ── Observability ────────────────────────────────────────────────────────────
# Required in production. Prometheus sends it; run infra/observability/setup.sh after setting it.
# At least 16 characters: openssl rand -hex 24
METRICS_TOKEN=
# Serve the API reference at /docs publicly (off by default in production).
DOCS_PUBLIC=false
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Grafana sign-in (reach it over an SSH tunnel). openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=

# ── Off-site backups (any S3-compatible store) ───────────────────────────────
# Leave OFFSITE_S3_ENDPOINT empty to keep backups on this server only (not recommended).
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_PROVIDER=Other
OFFSITE_S3_REGION=us-east-1
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
# Optional: AES256 for server-side encryption where the provider supports it.
OFFSITE_S3_SSE=
OFFSITE_HOUR=3
OFFSITE_KEEP_DELETED_DAYS=30
