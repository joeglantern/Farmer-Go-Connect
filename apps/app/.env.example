# FarmGo Connect app settings. Copy to .env for local builds; EAS builds take the same
# names from eas.json "env" or from EAS environment variables.

# The API the app talks to. Phones cannot reach "localhost": use the deployed HTTPS URL,
# or your computer's LAN address (for example http://192.168.1.2:4000) for local testing.
EXPO_PUBLIC_API_URL=

# Help and legal rows in Profile. Leave empty to hide a row.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_WHATSAPP=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Map tiles. Defaults to OpenStreetMap, which is fine for testing; production should use a
# keyed provider, for example https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
EXPO_PUBLIC_MAP_TILES=
EXPO_PUBLIC_MAP_ATTRIBUTION=
