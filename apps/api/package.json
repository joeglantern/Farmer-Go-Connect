    "create-admin": "tsx src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.2",
    "@bull-board/fastify": "^9.10.2",
    "@farmgo/auth": "workspace:*",
    "@farmgo/config": "workspace:*",
    "@farmgo/contracts": "workspace:*",
    "@farmgo/core": "workspace:*",
    "@farmgo/db": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/websocket": "^11.2.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
