    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.1",
    "pg": "^8.16.0",
    "pino-pretty": "^13.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
