    "@prisma/instrumentation": "7.10.0",
    "@scalar/fastify-api-reference": "^1.35.0",
    "@sentry/node": "^10.10.0",
    "better-auth": "1.7.5",
    "bullmq": "^5.58.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^7.0.0",
